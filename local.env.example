# Per-machine config for run.sh. Copy to `local.env` and edit (local.env is gitignored).
# All values are optional — run.sh auto-detects sensible defaults when unset.

# --- binaries (PATH by default; set only for non-standard installs) ---
# COLMAP_BIN=colmap                          # e.g. /opt/colmap/bin/colmap
# FFMPEG_BIN=/mnt/ssd1/bin/ffmpeg-nvdec      # ffmpeg with blurdetect (+ NVDEC for GPU decode)
# FFMPEG_HWACCEL=cuda                        # set to "none" to force CPU decode

# --- conda env ---
# CONDA_ROOT=/home/aibox/miniconda3          # auto-detected via `conda info --base` if unset
# CONDA_ENV=colmap_panel

# --- storage / browsing ---
# COLMAP_PANEL_DATA=/mnt/ssd1/colmap_panel/data   # job state + logs (use a roomy disk)
# COLMAP_PANEL_BROWSE_ROOT=/mnt/ssd1              # directory-picker root
# TMPDIR=/mnt/ssd1/colmap_panel/data/tmp          # ffmpeg/colmap scratch

# --- server ---
# HOST=127.0.0.1
# PORT=8077
