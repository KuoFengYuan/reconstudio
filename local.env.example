# Recon Studio — per-machine config for run.sh. Copy to `local.env` and edit (gitignored).
# All values are optional — run.sh auto-detects sensible defaults when unset.
# Note: storage vars use the RECON_STUDIO_ prefix; the tuning vars (MAX_JOBS /
# RESIZE_WORKERS / BACKENDS) still keep the COLMAP_PANEL_ prefix for back-compat.

# --- binaries (PATH by default; set only for non-standard installs) ---
# COLMAP_BIN=colmap                          # e.g. /opt/colmap/bin/colmap
# FFMPEG_BIN=/mnt/ssd1/bin/ffmpeg-nvdec      # ffmpeg with blurdetect (+ NVDEC for GPU decode)
# FFMPEG_HWACCEL=cuda                        # set to "none" to force CPU decode

# --- conda env ---
# CONDA_ROOT=/home/aibox/miniconda3          # auto-detected via `conda info --base` if unset
# CONDA_ENV=rec                              # the panel's own (torch-free) env (default: rec)

# --- training backends ---
# The trainers (gs2m, …) run in their OWN conda envs as subprocesses — the panel
# never imports torch. Built-in defaults assume sibling envs ($CONDA_ROOT/envs/gs2m)
# and sibling repos (../GS-2M). To override per machine, copy backends.example.json
# to backends.json. Run /doctor to verify each backend's env + CUDA before training.
# COLMAP_PANEL_BACKENDS=/path/to/backends.json   # default: ./backends.json

# --- storage / browsing ---
# RECON_STUDIO_DATA=/mnt/ssd1/recon_studio/data   # job state + logs (use a roomy disk)
# RECON_STUDIO_BROWSE_ROOT=/mnt/ssd1              # directory-picker root
# TMPDIR=/mnt/ssd1/recon_studio/data/tmp          # ffmpeg/colmap scratch

# --- concurrency ---
# How many jobs may run at the same time (抽幀/COLMAP/訓練/Mesh 共用此上限)。
# GPU 仍由各任務的 GPU 欄位手動指定;此數字不會自動分配顯卡。
# COLMAP_PANEL_MAX_JOBS=4
# COLMAP 的 FullHD resize 平行 ffmpeg worker 數(預設 = CPU 核數,上限 32)。
# COLMAP_PANEL_RESIZE_WORKERS=24

# --- server ---
# HOST=127.0.0.1
# PORT=8077
