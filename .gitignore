# runtime / scratch (job state, console + pipeline logs, points.ply cache, tmp)
data/
tmp/
*.tmp

# per-machine config (generated by ./setup.sh, or copied from *.example)
local.env
# setup.sh's re-run suggestion, written when local.env already exists
local.env.detected
backends.json

# python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/

# editor / OS
.vscode/
.idea/
.DS_Store

# vendored build artifact — regenerate with tools/build_supersplat.sh
static/supersplat/
