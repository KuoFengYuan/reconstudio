+const isExportPlyQuery = (data: any): boolean => {
+    return data && typeof data === 'object' && data.type === EXPORT_PLY && !data.data;
+};
+
+// Buffer scene.write output instead of downloading it. Implements the slice of
+// FileSystemWritableFileStream that BrowserFileWriter uses (seek/write/truncate/close).
+const exportPlyBytes = async (events: Events): Promise<ArrayBuffer> => {
+    const chunks: Uint8Array[] = [];
+    const stream = {
+        seek: async (_pos: number) => {},
+        write: async (data: ArrayBuffer | Uint8Array) => {
+            const u8 = data instanceof Uint8Array ? data : new Uint8Array(data);
+            chunks.push(u8.slice(0));
+        },
+        truncate: async (_size: number) => {},
+        close: async () => {}
+    };
+    await events.invoke('scene.write', 'ply', {
+        filename: 'point_cloud.ply',
+        splatIdx: 'all',
+        serializeSettings: {}            // defaults: deleted splats are always dropped
+    }, stream as unknown as FileSystemWritableFileStream);
+
+    const total = chunks.reduce((n, c) => n + c.byteLength, 0);
+    const out = new Uint8Array(total);
+    let offset = 0;
+    for (const c of chunks) {
+        out.set(c, offset);
+        offset += c.byteLength;
+    }
+    return out.buffer;
+};
