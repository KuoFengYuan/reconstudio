 import { Events } from './events';
 
 const IS_SCENE_DIRTY = 'supersplat:is-scene-dirty';
+// ReconStudio extension: serialize the current (background-removed) scene to a
+// 3DGS .ply and post the bytes back to the parent window, which uploads them to
+// the server. Lets the editor live in an iframe with a one-click "送回" round-trip.
+const EXPORT_PLY = 'supersplat:export-ply';
 
 interface IsSceneDirtyQuery {
     type: typeof IS_SCENE_DIRTY;
@@ -19,8 +23,41 @@ const isSceneDirtyQuery = (data: any): data is IsSceneDirtyQuery => {
