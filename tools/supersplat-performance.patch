diff --git a/src/remote-splat-loader.ts b/src/remote-splat-loader.ts
new file mode 100644
--- /dev/null
+++ b/src/remote-splat-loader.ts
@@ -0,0 +1,51 @@
+import { GSplatData, Quat } from 'playcanvas';
+
+import { setPreparedTextures } from './prepared-splat-resource';
+
+// Progress messages stay small. Typed array ownership is transferred, not copied.
+const reportSplatLoad = (phase: string, extra = {}) => {
+    if (window.parent !== window) {
+        window.parent.postMessage({ type: 'reconstudio:splat-load', phase, ...extra }, location.origin);
+    }
+};
+
+const loadRemoteSplat = (filename: string, skipReorder?: boolean) => new Promise<{
+    gsplatData: GSplatData; transform: { rotation: Quat };
+}>((resolve, reject) => {
+    const worker = new Worker(new URL('splat-loader-worker.js', document.baseURI), { type: 'module' });
+    const cleanup = () => {
+        worker.terminate();
+        window.removeEventListener('pagehide', cleanup);
+    };
+    window.addEventListener('pagehide', cleanup, { once: true });
+    worker.onerror = (event) => {
+        cleanup();
+        reportSplatLoad('error', { message: event.message });
+        reject(new Error(event.message || 'Background loader failed'));
+    };
+    worker.onmessage = (event) => {
+        const data = event.data;
+        if (data.type === 'progress') {
+            reportSplatLoad('loading', { loaded: data.loaded, total: data.total });
+        } else if (data.type === 'packing') {
+            reportSplatLoad('packing', { count: data.count });
+        } else if (data.type === 'result') {
+            cleanup();
+            reportSplatLoad('gpu', { count: data.count });
+            const gsplatData = new GSplatData(data.elements, data.comments);
+            setPreparedTextures(gsplatData, data.textures);
+            resolve({
+                gsplatData,
+                transform: { rotation: new Quat(data.rotation.x, data.rotation.y, data.rotation.z, data.rotation.w) }
+            });
+        } else if (data.type === 'error') {
+            cleanup();
+            reportSplatLoad('error', { message: data.message });
+            reject(new Error(data.message));
+        }
+    };
+    reportSplatLoad('loading');
+    worker.postMessage({ filename, skipReorder });
+});
+
+export { loadRemoteSplat, reportSplatLoad };
diff --git a/src/splat-loader-worker.ts b/src/splat-loader-worker.ts
new file mode 100644
--- /dev/null
+++ b/src/splat-loader-worker.ts
@@ -0,0 +1,61 @@
+// Recon Studio: keep decoding, SH materialization and Morton ordering off the UI.
+import { UrlReadFileSystem, WebPCodec, WorkerQueue } from '@playcanvas/splat-transform';
+
+import { GSplatResource } from 'playcanvas';
+
+import { loadGSplatData, validateGSplatData } from './io/read/loader';
+
+const scope = self as unknown as DedicatedWorkerGlobalScope;
+WorkerQueue.maxWorkers = 0;
+WebPCodec.wasmUrl = new URL('static/lib/webp/webp.wasm', scope.location.href).href;
+
+scope.onmessage = async (event) => {
+    const { filename, skipReorder } = event.data;
+    const fs = new UrlReadFileSystem();
+    let lastProgress = 0;
+    try {
+        const result = await loadGSplatData(filename, {
+            createSource: (name: string) => fs.createSource(name, (loaded, total) => {
+                const now = performance.now();
+                if (now - lastProgress > 150 || (total && loaded === total)) {
+                    lastProgress = now;
+                    scope.postMessage({ type: 'progress', loaded, total });
+                }
+            })
+        }, skipReorder);
+        if (!result) throw new Error('No splat data');
+        validateGSplatData(result.gsplatData);
+        const data = result.gsplatData;
+        scope.postMessage({ type: 'packing', count: data.numSplats });
+        // Reuse the exact engine packing algorithms with CPU-only texture sinks.
+        // No WebGL context is created in the Worker and no coefficients are lost.
+        const textures: Record<string, Uint16Array | Uint32Array> = {
+            splatColor: new Uint16Array(data.numSplats * 4),
+            transformA: new Uint32Array(data.numSplats * 4),
+            transformB: new Uint16Array(data.numSplats * 4)
+        };
+        if (data.shBands > 0) textures.splatSH_1to3 = new Uint32Array(data.numSplats * 4);
+        if (data.shBands > 1) {
+            textures.splatSH_4to7 = new Uint32Array(data.numSplats * 4);
+            textures.splatSH_8to11 = new Uint32Array(data.numSplats * (data.shBands > 2 ? 4 : 1));
+        }
+        if (data.shBands > 2) textures.splatSH_12to15 = new Uint32Array(data.numSplats * 4);
+        const cpuResource = {
+            numSplats: data.numSplats, shBands: data.shBands,
+            streams: { getTexture: (name: string) => textures[name] ? { lock: () => textures[name], unlock: () => {} } : null }
+        } as unknown as GSplatResource;
+        GSplatResource.prototype.updateColorData.call(cpuResource, data);
+        GSplatResource.prototype.updateTransformData.call(cpuResource, data);
+        if (data.shBands > 0) GSplatResource.prototype.updateSHData.call(cpuResource, data);
+        const { elements, comments } = result.gsplatData;
+        const buffers = elements.flatMap(element => element.properties.map(property => property.storage?.buffer))
+        .filter((buffer): buffer is ArrayBuffer => buffer instanceof ArrayBuffer);
+        scope.postMessage({
+            type: 'result', elements, comments, textures,
+            rotation: result.transform.rotation,
+            count: result.gsplatData.numSplats
+        }, [...new Set([...buffers, ...Object.values(textures).map(texture => texture.buffer as ArrayBuffer)])]);
+    } catch (error) {
+        scope.postMessage({ type: 'error', message: String(error) });
+    }
+};
diff --git a/src/prepared-splat-resource.ts b/src/prepared-splat-resource.ts
new file mode 100644
--- /dev/null
+++ b/src/prepared-splat-resource.ts
@@ -0,0 +1,38 @@
+import { GSplatData, GSplatResource } from 'playcanvas';
+
+// The Worker executes the engine's own packing routines. Here only copy their
+// final texture bytes; keep GSplatData intact for selection, editing and export.
+type Packed = Record<string, Uint16Array | Uint32Array>;
+const pending = new WeakMap<GSplatData, Packed>();
+
+class PreparedSplatResource extends GSplatResource {
+    copyPacked(data: GSplatData, names: string[]) {
+        const packed = pending.get(data);
+        if (!packed) return false;
+        for (const name of names) {
+            const source = packed[name];
+            if (!source) continue;
+            const texture = this.streams.getTexture(name);
+            const target = texture.lock() as Uint16Array | Uint32Array;
+            target.set(source);
+            texture.unlock();
+        }
+        return true;
+    }
+
+    updateColorData(data: GSplatData) {
+        if (!this.copyPacked(data, ['splatColor'])) super.updateColorData(data);
+    }
+
+    updateTransformData(data: GSplatData) {
+        if (!this.copyPacked(data, ['transformA', 'transformB'])) super.updateTransformData(data);
+    }
+
+    updateSHData(data: GSplatData) {
+        if (!this.copyPacked(data, ['splatSH_1to3', 'splatSH_4to7', 'splatSH_8to11', 'splatSH_12to15'])) super.updateSHData(data);
+    }
+}
+
+const setPreparedTextures = (data: GSplatData, packed: Packed) => pending.set(data, packed);
+const clearPreparedTextures = (data: GSplatData) => pending.delete(data);
+export { PreparedSplatResource, setPreparedTextures, clearPreparedTextures };
