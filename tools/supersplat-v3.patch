 };
 
+const isExportPlyQuery = (data: any): boolean => {
+    return data && typeof data === 'object' && data.type === EXPORT_PLY && !data.data;
+};
+
+// Buffer scene.write output instead of downloading it. Implements the slice of
+// FileSystemWritableFileStream that BrowserFileWriter uses (seek/write/truncate/close).
+const exportPlyBytes = async (events: Events): Promise<ArrayBuffer> => {
+    const chunks: Uint8Array[] = [];
+    const stream = {
+        seek: async (_pos: number) => {},
+        write: async (data: ArrayBuffer | Uint8Array) => {
+            const u8 = data instanceof Uint8Array ? data : new Uint8Array(data);
+            chunks.push(u8.slice(0));
+        },
+        truncate: async (_size: number) => {},
+        close: async () => {},
+        abort: async () => { chunks.length = 0; }
+    };
+    const written = await events.invoke('scene.write', 'ply', {
+        filename: 'point_cloud.ply',
+        splatIdx: 'all',
+        serializeSettings: {}            // defaults: deleted splats are always dropped
+    }, stream as unknown as FileSystemWritableFileStream);
+
+    if (written === false) throw new Error('Scene export failed');
+    const total = chunks.reduce((n, c) => n + c.byteLength, 0);
+    const out = new Uint8Array(total);
+    let offset = 0;
+    for (const c of chunks) {
+        out.set(c, offset);
+        offset += c.byteLength;
+    }
+    return out.buffer;
+};
+
+const reportSplatLoad = (phase: string, extra = {}) => {
+    if (window.parent !== window) {
+        window.parent.postMessage({ type: 'reconstudio:splat-load', phase, ...extra }, location.origin);
+    }
+};
+
 const registerIframeApi = (events: Events) => {
-    window.addEventListener('message', (event: MessageEvent) => {
+    window.addEventListener('message', async (event: MessageEvent) => {
         const source = event.source as Window | null;
         if (!source) {
             return;
         }
 
+        if (isExportPlyQuery(event.data) && event.source === window.parent && event.origin === location.origin) {
+            try {
+                const buffer = await exportPlyBytes(events);
+                source.postMessage({ type: EXPORT_PLY, data: buffer }, event.origin, [buffer]);
+            } catch (err) {
+                source.postMessage({ type: EXPORT_PLY, error: String(err) }, event.origin);
+            }
+            return;
+        }
+
         if (isSceneDirtyQuery(event.data)) {
             const response: IsSceneDirtyResponse = {
                 type: IS_SCENE_DIRTY,
@@ -65,4 +117,4 @@ const requestNavigateHome = () => {
